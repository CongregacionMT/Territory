{
  "name": "territory",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "wheelwright": "ng serve --configuration=wheelwright",
    "maria-teresa": "ng serve --configuration=maria-teresa",
    "hughes": "ng serve --configuration=hughes",
    "arias": "ng serve --configuration=arias",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "analyze": "npm run build:stats && webpack-bundle-analyzer dist/territory/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "deploy": "node scripts/deploy.js",
    "test-congregation": "ng serve --configuration=test-congregation",
    "format": "prettier --write .",
    "prepare": "husky",
    "sonar": "sonar-scanner"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "~22.2.4",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "~22.2.4",
    "@angular/platform-browser-dynamic": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@angular/service-worker": "~22.2.4",
    "@tmcw/togeojson": "^7.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "canvas-confetti": "^1.9.4",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.5",
    "@analogjs/vitest-angular": "^2.9.5",
    "@angular-devkit/core": "^22.2.5",
    "@angular-devkit/schematics": "^22.2.5",
    "@angular/build": "^22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@eslint/js": "^9.39.5",
    "@schematics/angular": "^20.3.42",
    "@types/canvas-confetti": "^1.9.0",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.66.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.6.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "inquirer": "^14.2.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "sonarqube-scanner": "^5.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.12",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "lint-staged": {
    "*.{html,json,scss,css,md}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
