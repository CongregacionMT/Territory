{
  "name": "territory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "wheelwright": "ng serve --configuration=wheelwright",
    "maria-teresa": "ng serve --configuration=maria-teresa",
    "hughes": "ng serve --configuration=hughes",
    "arias": "ng serve --configuration=arias",
    "build": "ng build",
    "build:stats": "ng build --stats-json",
    "analyze": "npm run build:stats && webpack-bundle-analyzer dist/territory/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "lint": "ng lint",
    "deploy": "node scripts/deploy.js",
    "test-congregation": "ng serve --configuration=test-congregation"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.1",
    "@angular/cdk": "^20.1.2",
    "@angular/common": "^20.1.1",
    "@angular/compiler": "^20.1.1",
    "@angular/core": "~20.1.1",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "~20.1.1",
    "@angular/material": "^20.1.2",
    "@angular/platform-browser": "~20.1.1",
    "@angular/platform-browser-dynamic": "~20.1.1",
    "@angular/router": "~20.1.1",
    "@angular/service-worker": "~20.1.1",
    "@tmcw/togeojson": "^7.1.2",
    "@xmldom/xmldom": "^0.9.10",
    "firebase": "^11.10.0",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.5.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.0",
    "@analogjs/vitest-angular": "^2.7.0",
    "@angular-devkit/core": "^20.1.1",
    "@angular-devkit/schematics": "^20.1.1",
    "@angular-eslint/builder": "20.1.1",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "^20.1.1",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/build": "^20.1.1",
    "@angular/cli": "~20.1.1",
    "@angular/compiler-cli": "^20.1.1",
    "@schematics/angular": "^20.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.14",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "eslint": "^9.31.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10",
    "webpack-bundle-analyzer": "^4.8.0"
  }
}
